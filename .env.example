# Versao do Sistema (usada nas imagens do docker-compose-prod.yml - padrao: latest)
# APP_VERSION=2.9.2

# Banco Environments
POSTGRES_USER=admin
# Defina uma senha exclusiva e use o mesmo valor em DEFAULTCONNECTION.
POSTGRES_PASSWORD=
POSTGRES_DB=gestao_db
PORT_MACHINE_POSTGRES=5432
DEFAULTCONNECTION="Host=postgres;Port=5432;Database=gestao_db;Username=admin;Password=;"

# Backend Environments
# Garage: gere separadamente 32 bytes aleatórios em hexadecimal (não reutilize exemplos).
GARAGE_RPC_SECRET=
# Gere uma chave exclusiva com pelo menos 32 bytes. Nunca reutilize uma chave publicada.
TOKEN_KEY=
# Expiração em horas, preservando a configuração existente; máximo de 8 horas.
ACCESSTOKEN_EXPIRATION_TIME=8
MAILSETTINGS_HOST=smtp.gmail.com
MAILSETTINGS_PORT=587
MAILSETTINGS_NAME=Gestão Tcc
MAILSETTINGS_EMAILID=example@example.com
MAILSETTINGS_USERNAME=example@example.com
MAILSETTINGS_PASSWORD=
# Compatibilidade de configuração; o código de recuperação usa alfabeto seguro fixo.
COMBINATION_STRING_FOR_ACCESSCODE="ABCDEFGHJKLMNPQRSTUVWXYZ23456789"
STORAGE_ENDPOINT="http://garage:3900"
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET_NAME="document-tccs-example"
PORT_MACHINE_BACKEND=8080
CORS_SETTINGS_URL_FRONT="http://localhost:3000"
# Google OAuth: configure as credenciais e a URL autorizada em cada ambiente.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="http://localhost:8080/api/Auth/google/callback"
GOOGLE_ALLOWED_DOMAINS=ifpe.edu.br,discente.ifpe.edu.br
URL_TEMPO="http://localhost:4318/v1/traces"
URL_LOKI="http://localhost:3100"

# Frontend Environments
NEXT_PUBLIC_API_URL=http://localhost:8080/api
PORT_MACHINE_FRONTEND=3000

# Observabilidade Environments
PORT_MACHINE_GRAFANA=3001
PORT_MACHINE_LOKI=3100
PORT_MACHINE_PROMETHEUS=9090
PORT_FRONTEND_TEMPO=3200
PORT_SEND_TRACES_TEMPO=4318
HOME_PATH=/path/to/your/project

# Garage Environments
PORT_MACHINE_S3_GARAGE=3900
PORT_MACHINE_ADMIN_GARAGE=3901
